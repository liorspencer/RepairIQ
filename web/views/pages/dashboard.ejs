    const btn_notificacao = document.getElementById("btn_notificacao");

    function esconder() {
        if(dadosRecuperados.nivel_acesso==3){
        console.log(3);
        btn_equip.style.visibility = "collapse";
        btn_func.style.visibility = "collapse";
    }else if(dadosRecuperados.nivel_acesso==2){
