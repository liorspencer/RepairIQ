<script>

    
    const btn_eqp = document.getElementById("btn_equipamentos");
    const btn_os = document.getElementById("btn_os");
    const btn_modelo_os = document.getElementById("btn_modelo_os");
    const btn_func = document.getElementById("btn_funcionario");
